BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=./data/3p-demo.sqlite

# Flaremail web (Vite) — authorize goes here so the session cookie is sent.
# Vite should proxy /api to the deployed Worker (API_PROXY_TARGET).
FLAREMAIL_WEB_URL=http://localhost:5173

# Deployed Worker — token, userinfo, and OIDC issuer.
FLAREMAIL_API_URL=https://your-worker.workers.dev

# From Flaremail Management → OIDC clients (shown once on create / regenerate).
FLAREMAIL_CLIENT_ID=
FLAREMAIL_CLIENT_SECRET=
