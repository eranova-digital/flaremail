# Generated by `flaremail sync` from flaremail.conf.jsonc. Do not edit by hand.
#
# Used by:
# - Drizzle migrations (`npm run db:migrate`)
# - `wrangler dev`: copied into Wrangler's local Hyperdrive stub so
#   `env.HYPERDRIVE.connectionString` still works without a deployed Hyperdrive hop
#
# Worker Vitest must not depend on this URL (tests must not write to Postgres).
# Deployed Workers connect via the Hyperdrive binding in wrangler.jsonc instead.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Session signing secret for cookies (set in production via flaremail deploy).
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Local gate+core origin. Production WEB_ORIGIN is vars in generated wrangler.jsonc.
WEB_ORIGIN=http://localhost:8787

# ES256 private JWK for OIDC access/ID tokens (ADR-0007). Generated by `flaremail init`.
OIDC_SIGNING_JWK=
