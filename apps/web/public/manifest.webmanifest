{
	"name": "FlareMail",
	"short_name": "FlareMail",
	"start_url": "/",
	"display": "standalone",
	"background_color": "#ffffff",
	"theme_color": "#1447e6",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	],
	"protocol_handlers": [
		{
			"protocol": "mailto",
			"url": "/compose?mailto=%s"
		}
	]
}
