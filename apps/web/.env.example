# Same-origin API path — browser calls /api/v1 (gate proxies to core).
API_URL=/api/v1

# Where Vite forwards /api during `web:dev` only.
# Prefer the deployed gate hostname (recommended DX):
#   https://mail.example.com
# Local gate+core (`npm run dev`): http://localhost:8787
API_PROXY_TARGET=https://your-gate-hostname.example
