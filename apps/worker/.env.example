# Local-only: direct Neon Postgres URL (host like ep-xxx.neon.tech).
# NOT a Hyperdrive connection string — Hyperdrive is unavailable during local dev.
#
# Used by:
# - Drizzle migrations (`npm run db:migrate`)
# - `wrangler dev` / tests: copied into Wrangler's local Hyperdrive stub so
#   `env.HYPERDRIVE.connectionString` still works without a deployed Hyperdrive hop
#
# Deployed Workers connect via the Hyperdrive binding in wrangler.jsonc instead.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Bearer token for /api/v1/* (set the same value in production via `wrangler secret put`).
API_BEARER_TOKEN=replace-with-a-long-random-token
