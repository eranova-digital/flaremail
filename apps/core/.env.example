# Local-only: direct Neon Postgres URL (host like ep-xxx.neon.tech).
# NOT a Hyperdrive connection string — Hyperdrive is unavailable during local dev.
#
# Used by:
# - Drizzle migrations (`npm run db:migrate`)
# - `wrangler dev`: copied into Wrangler's local Hyperdrive stub so
#   `env.HYPERDRIVE.connectionString` still works without a deployed Hyperdrive hop
#
# Worker Vitest must not depend on this URL (tests must not write to Postgres).
# Deployed Workers connect via the Hyperdrive binding in wrangler.jsonc instead.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Session signing secret for cookies (set in production via `wrangler secret put`).
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public gate hostname URL for OIDC redirects / cookie origin (same origin as /api).
# Local gate+core: http://localhost:8787 — production: https://your-gate-hostname
WEB_ORIGIN=http://localhost:8787

# ES256 private JWK for OIDC access/ID tokens (ADR-0007). Generate with:
#   node -e "const {generateKeyPairSync}=require('crypto');const {exportJWK}=require('jose');(async()=>{const {privateKey}=generateKeyPairSync('ec',{namedCurve:'P-256'});const jwk=await exportJWK(privateKey);jwk.kid='flaremail';jwk.alg='ES256';jwk.use='sig';console.log(JSON.stringify(jwk))})()"
# Then: wrangler secret put OIDC_SIGNING_JWK
# Paste the generated JSON on one line. Never commit a real private key.
OIDC_SIGNING_JWK=
