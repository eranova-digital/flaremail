# Same-origin API path — browser calls /api/v1, Vite proxies to the Worker.
API_URL=/api/v1

# Where Vite forwards /api requests (dev only).
# Local wrangler:  http://localhost:8787
# Deployed Worker: https://your-worker.workers.dev  (always https)
API_PROXY_TARGET=http://localhost:8787

# Bearer token — must match the Worker's API_BEARER_TOKEN secret.
API_BEARER_TOKEN=dev-token
